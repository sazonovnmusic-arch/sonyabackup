5\u043c\u0430\u0442\u0438\u043a\u0430: [\u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438]\n\ud83d\udcdd \u041f\u043e\u0447\u0435\u043c\u0443 \u044d\u0442\u043e \u0442\u0440\u0435\u043d\u0434: [1-2 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u2014 \u043f\u043e\u0447\u0435\u043c\u0443 \u043a\u0430\u043d\u0430\u043b \u0440\u0430\u0441\u0442\u0451\u0442, \u0447\u0442\u043e \u0438\u043c\u0435\u043d\u043d\u043e \u0445\u0430\u0439\u043f\u0443\u0435\u0442]\n\ud83d\udca1 \u0418\u0434\u0435\u044f \u0434\u043b\u044f \u043b\u043e\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438: [\u043a\u0430\u043a \u044d\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u0438\u0439 \u2014 \u043a\u0440\u0430\u0442\u043a\u043e]\n---\n\n\u0415\u0441\u043b\u0438 \u043d\u0430\u0439\u0434\u0435\u043d\u043e 0 \u043a\u0430\u043d\u0430\u043b\u043e\u0432 \u2014 \u043f\u0438\u0448\u0438 \u0447\u0435\u0441\u0442\u043d\u043e, \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0432\u044b\u0434\u0443\u043c\u044b\u0432\u0430\u0439.\n\u0415\u0441\u043b\u0438 \u043d\u0430\u0439\u0434\u0435\u043d\u043e 1-3 \u043a\u0430\u043d\u0430\u043b\u0430 \u2014 \u043e\u0442\u043b\u0438\u0447\u043d\u043e, \u044d\u0442\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e.\n\u0411\u043e\u043b\u044c\u0448\u0435 5 \u043d\u0435 \u043d\u0443\u0436\u043d\u043e.\n\n\u0412\u0410\u0416\u041d\u041e:\n- \u0422\u043e\u043b\u044c\u043a\u043e \u0420\u0415\u0410\u041b\u042c\u041d\u042b\u0415 \u043a\u0430\u043d\u0430\u043b\u044b, \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0435 \u0447\u0435\u0440\u0435\u0437 API/\u0431\u0440\u0430\u0443\u0437\u0435\u0440\n- \u041d\u0415 \u043f\u0440\u0438\u0434\u0443\u043c\u044b\u0432\u0430\u0442\u044c \u043a\u0430\u043d\u0430\u043b\u044b \u0438\u0437 \u0433\u043e\u043b\u043e\u0432\u044b\n- 